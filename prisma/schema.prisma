generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  VENDOR
  ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(BUYER)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String        @id @default(uuid())
  title       String
  category    String
  price       Float
  description String
  fileUrl     String
  status      ProductStatus @default(PENDING)
  vendorId    String
  vendor      User          @relation(fields: [vendorId], references: [id])
  createdAt   DateTime      @default(now())
}